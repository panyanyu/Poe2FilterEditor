<Window x:Class="Poe2FilterEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:Poe2FilterEditor.Infrastructure"
        xmlns:views="clr-namespace:Poe2FilterEditor.Views"
        xmlns:vm="clr-namespace:Poe2FilterEditor.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <infra:NullToVisibilityConverter x:Key="NullToVis" />
        <infra:NullToVisibilityConverter x:Key="InverseNullToVis" />
        <infra:ColorToBrushConverter x:Key="ColorToBrush" />
        <infra:InverseBoolConverter x:Key="InverseBool" />
        <infra:BoolToBrushConverter x:Key="BoolToBrush" />

        <!-- 标签上的小叉 -->
        <Style x:Key="ChipCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <TextBlock x:Name="Txt" Text="✕"
                                       FontSize="10"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E2622" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource DangerLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 颜色块按钮 -->
        <Style x:Key="SwatchButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏：分组标题 -->
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="12,14,10,4">
                <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource GoldBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Border Height="1" Background="#2A2319" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- 左栏：规则卡片 -->
        <DataTemplate x:Key="RuleTemplate">
            <Border x:Name="Card" Margin="6,2" Padding="0" CornerRadius="5" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Bar" Grid.Column="0" Background="Transparent" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="10,7,8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Head"
                                       Text="{Binding Headline}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1"
                                    Background="{Binding BadgeColor}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}" FontSize="9" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="Sub"
                                   Text="{Binding Subline}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="Card" Property="Background" Value="#241E17" />
                    <Setter TargetName="Head" Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <views:PaneEntryTemplateSelector x:Key="PaneEntrySelector"
                                         SectionTemplate="{StaticResource SectionTemplate}"
                                         RuleTemplate="{StaticResource RuleTemplate}" />

        <!-- 物品 / 类别标签 -->
        <DataTemplate x:Key="ItemChipTemplate">
            <Border x:Name="Chip"
                    Background="#2A241D"
                    BorderBrush="{StaticResource LineStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="10,4"
                    Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock Text="{Binding Display}"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"
                               ToolTip="{Binding ToolTipText}" />
                    <TextBlock x:Name="UnknownMark"
                               Text="?"
                               FontSize="10"
                               Foreground="{StaticResource WarnLightBrush}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               ToolTip="内置映射表中没有这个英文名，可在物品选择器里补录" />
                    <Button Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnRemoveItemChip" Tag="{Binding NameEn}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                    <Setter TargetName="UnknownMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="#7A5A28" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ClassChipTemplate">
            <Border Background="#232021"
                    BorderBrush="#4A4034"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="10,4"
                    Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock Text="{Binding Display}" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" ToolTip="{Binding ToolTipText}" />
                    <Button Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnRemoveClassChip" Tag="{Binding NameEn}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WindowBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ==================== 顶部工具栏 ==================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource GoldGradientBrush}">
                            <Path Data="M 8 0 L 16 8 L 8 16 L 0 8 Z"
                                  Fill="#1A1305"
                                  Width="14"
                                  Height="14"
                                  Stretch="Fill"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="流放之路 2" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="国服物品过滤器编辑器" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="22,0,0,0"
                            VerticalAlignment="Center"
                            Background="#1B1611"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding IsDirty, Converter={StaticResource BoolToBrush}, ConverterParameter='#E0B94B|#3E8E63'}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Button Content="新建" Command="{Binding NewCommand}" Style="{StaticResource BaseButton}" Margin="0,0,6,0" ToolTip="Ctrl+N" />
                        <Button Content="打开" Command="{Binding OpenCommand}" Style="{StaticResource BaseButton}" Margin="0,0,6,0" ToolTip="Ctrl+O" />
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" ToolTip="Ctrl+S" />
                        <Button Content="另存为" Command="{Binding SaveAsCommand}" Style="{StaticResource BaseButton}" Margin="0,0,14,0" />
                        <Border Width="1" Background="{StaticResource LineBrush}" Margin="0,10,14,10" />
                        <Button Content="↶" Command="{Binding UndoCommand}" Style="{StaticResource IconButton}" Margin="0,0,4,0" ToolTip="撤销 Ctrl+Z" />
                        <Button Content="↷" Command="{Binding RedoCommand}" Style="{StaticResource IconButton}" ToolTip="重做 Ctrl+Y" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="230">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="搜索规则 / 物品名"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="12"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource InverseNullToVis}, ConverterParameter=invert}" />
                        </Grid>
                        <CheckBox Content="中文名" IsChecked="{Binding ShowChineseNames}" Margin="14,0,10,0" VerticalAlignment="Center" ToolTip="界面显示国服中文名，文件仍写入英文内部名" />
                        <Button Content="⚙" Click="OnOpenSettings" Style="{StaticResource IconButton}" ToolTip="设置" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 主体三栏 ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" MinWidth="240" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="440" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 左：规则列表 -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,14,10,8">
                            <StackPanel>
                                <TextBlock Text="规则" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding RuleCount, StringFormat='共 {0} 条'}"
                                           Style="{StaticResource FaintText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Content="＋ 新增规则"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Command="{Binding AddRuleCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,5"
                                    MinHeight="28" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="RuleList"
                                 ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ItemTemplateSelector="{StaticResource PaneEntrySelector}"
                                 Margin="4,0,4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="↑" Command="{Binding MoveUpCommand}" Style="{StaticResource IconButton}" ToolTip="上移" />
                                <Button Content="↓" Command="{Binding MoveDownCommand}" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="下移" />
                                <Button Content="⧉" Command="{Binding DuplicateRuleCommand}" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="复制规则 Ctrl+D" />
                                <Button Content="◐" Command="{Binding ToggleDisableCommand}" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="停用 / 启用（整块注释）" />
                                <Button Content="✕" Command="{Binding DeleteRuleCommand}" Style="{StaticResource DangerButton}" Padding="0" Width="30" Height="30" MinHeight="30" Margin="2,0,0,0" ToolTip="删除规则" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                <!-- 中：属性面板 -->
                <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 面板标题 -->
                        <Border Grid.Row="0" Padding="18,14,14,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectionTitle}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedRule.Subline}"
                                               Style="{StaticResource FaintText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                    <Button Content="显示 / 隐藏"
                                            Click="OnToggleShow"
                                            Style="{StaticResource BaseButton}"
                                            Padding="10,5"
                                            MinHeight="28"
                                            Margin="0,0,6,0" />
                                    <Button Content="停用"
                                            Click="OnToggleDisable"
                                            Style="{StaticResource BaseButton}"
                                            Padding="10,5"
                                            MinHeight="28" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <TabControl Style="{StaticResource PanelTabControl}" DataContext="{Binding SelectedRule}">
                                <!-- 条件 -->
                                <TabItem Header="条件">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,18">
                                        <StackPanel>
                                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="规则类型" Style="{StaticResource SectionTitle}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Content="显示（Show）" IsChecked="{Binding ShowEnabled}" Margin="0,0,18,0" />
                                                        <CheckBox Content="停用此规则" IsChecked="{Binding DisabledEnabled}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="稀有度" Style="{StaticResource SectionTitle}" />
                                            <ComboBox ItemsSource="{Binding RarityChoices}"
                                                      DisplayMemberPath="Text"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding RarityValue}"
                                                      Width="180"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,16" />

                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="物品类别" Style="{StaticResource SectionTitle}" />
                                                <Button Content="＋ 添加类别"
                                                        Click="OnAddClass"
                                                        Style="{StaticResource LinkButton}"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,-4,0,0" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding ClassChips}" ItemTemplate="{StaticResource ClassChipTemplate}" Margin="0,0,0,14">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="物品名称（界面中文 / 文件英文）" Style="{StaticResource SectionTitle}" />
                                                <Button Content="＋ 添加物品"
                                                        Click="OnAddItem"
                                                        Style="{StaticResource LinkButton}"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,-4,0,0" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding ItemChips}" ItemTemplate="{StaticResource ItemChipTemplate}" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Button Content="＋ 从国服物品库选择"
                                                    Click="OnAddItem"
                                                    Style="{StaticResource BaseButton}"
                                                    HorizontalAlignment="Left"
                                                    Padding="14,7"
                                                    Margin="0,4,0,16"
                                                    Foreground="{StaticResource GoldLightBrush}"
                                                    BorderBrush="{StaticResource GoldDarkBrush}" />

                                            <TextBlock Text="数值条件" Style="{StaticResource SectionTitle}" />
                                            <ItemsControl ItemsSource="{Binding Numerics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="118" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ChineseName}" Style="{StaticResource FieldLabel}" />
                                                            <ComboBox Grid.Column="2"
                                                                      Width="66"
                                                                      ItemsSource="{Binding OperatorChoices}"
                                                                      DisplayMemberPath="Value"
                                                                      SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Operator}"
                                                                      Margin="0,0,6,0" />
                                                            <TextBox Grid.Column="3"
                                                                     Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                                                     Width="96"
                                                                     HorizontalAlignment="Left" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="状态条件" Style="{StaticResource SectionTitle}" Margin="0,12,0,10" />
                                            <ItemsControl ItemsSource="{Binding Booleans}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ChineseName}" Style="{StaticResource FieldLabel}" />
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding Choices}"
                                                                      DisplayMemberPath="Text"
                                                                      SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Value}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Visibility="{Binding HasOtherConditions, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                                                <TextBlock Text="其他条件（原样保留，不可在此编辑）" Style="{StaticResource SectionTitle}" />
                                                <ItemsControl ItemsSource="{Binding OtherConditions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- 外观 -->
                                <TabItem Header="外观">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,18">
                                        <StackPanel>
                                            <TextBlock Text="颜色" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="边框颜色" Style="{StaticResource FieldLabel}" />
                                                        <Button Grid.Column="1" Style="{StaticResource SwatchButton}" Background="{Binding BorderColorBrush}" Click="OnPickBorderColor" />
                                                        <TextBlock Grid.Column="2" Text="{Binding BorderColor}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnClearBorderColor" ToolTip="移除" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="背景颜色" Style="{StaticResource FieldLabel}" />
                                                        <Button Grid.Column="1" Style="{StaticResource SwatchButton}" Background="{Binding BackgroundColorBrush}" Click="OnPickBackgroundColor" />
                                                        <TextBlock Grid.Column="2" Text="{Binding BackgroundColor}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnClearBackgroundColor" ToolTip="移除" />
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="文字颜色" Style="{StaticResource FieldLabel}" />
                                                        <Button Grid.Column="1" Style="{StaticResource SwatchButton}" Background="{Binding TextColorBrush}" Click="OnPickTextColor" />
                                                        <TextBlock Grid.Column="2" Text="{Binding TextColor}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnClearTextColor" ToolTip="移除" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="字体与光柱" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="字体大小" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Grid.Column="1" Text="{Binding FontSizeText, UpdateSourceTrigger=LostFocus, Delay=150}" ToolTip="1 - 45" />
                                                        <TextBlock Grid.Column="2" Text="1 ~ 45，留空表示不设置" Style="{StaticResource FaintText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="掉落光柱" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding EffectColorChoices}"
                                                                  DisplayMemberPath="Text"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding EffectColor}"
                                                                  ToolTip="留空表示不设置" />
                                                        <CheckBox Grid.Column="2" Content="Temp" IsChecked="{Binding EffectTemp}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnClearEffect" HorizontalAlignment="Right" ToolTip="移除光柱" />
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="小地图图标" Style="{StaticResource FieldLabel}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <ComboBox Width="76" ItemsSource="{Binding IconSizeChoices}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding MinimapSize}" Margin="0,0,6,0" ToolTip="大小" />
                                                            <ComboBox Width="76" ItemsSource="{Binding IconColorChoices}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding MinimapColorValue}" Margin="0,0,6,0" ToolTip="颜色" />
                                                            <ComboBox Width="86" ItemsSource="{Binding IconShapeChoices}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding MinimapShapeValue}" ToolTip="形状" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnClearMinimap" ToolTip="移除图标" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitle}" />
                                            <Border BorderBrush="{Binding PreviewBorderBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="5"
                                                    Padding="0">
                                                <Grid>
                                                    <Border Background="{Binding PreviewBackgroundBrush}" CornerRadius="3" MinHeight="74" />
                                                    <StackPanel Margin="14,12">
                                                        <TextBlock Text="{Binding Headline}"
                                                                   Foreground="{Binding PreviewTextBrush}"
                                                                   FontSize="{Binding PreviewFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Subline}"
                                                                   Foreground="{Binding PreviewTextBrush}"
                                                                   Opacity="0.7"
                                                                   FontSize="{Binding PreviewFontSize}"
                                                                   Margin="0,3,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- 音效 -->
                                <TabItem Header="音效">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,18">
                                        <StackPanel>
                                            <TextBlock Text="掉落提示音" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="音效文件（相对客户端目录，例如 sounds/神圣石.mp3）"
                                                               Style="{StaticResource FaintText}"
                                                               Margin="0,0,0,8"
                                                               TextWrapping="Wrap" />
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding SoundPath, UpdateSourceTrigger=LostFocus}" />
                                                        <Button Grid.Column="1" Content="浏览…" Click="OnBrowseSound" Style="{StaticResource BaseButton}" Margin="6,0,0,0" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="音量" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Grid.Column="1" Text="{Binding VolumeText, UpdateSourceTrigger=LostFocus}" ToolTip="0 - 300" />
                                                        <TextBlock Grid.Column="2" Text="0 ~ 300" Style="{StaticResource FaintText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <WrapPanel>
                                                        <Button Content="按物品中文名生成路径" Click="OnGenerateSoundPath" Style="{StaticResource BaseButton}" Padding="10,5" MinHeight="28" Margin="0,0,6,0" />
                                                        <Button Content="▶ 试听" Click="OnPlaySound" Style="{StaticResource BaseButton}" Padding="10,5" MinHeight="28" Margin="0,0,6,0" />
                                                        <Button Content="移除音效" Click="OnClearSound" Style="{StaticResource DangerButton}" Padding="10,5" MinHeight="28" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding SoundStatus}" Style="{StaticResource FaintText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="说明" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                                            <TextBlock Style="{StaticResource FaintText}" TextWrapping="Wrap" LineHeight="20">
                                                音效路径需要和客户端目录结构一致，编辑器只在本地做存在性提示，不会改动文件本身。
                                                POE2 建议把音效放在过滤器同目录下的 sounds 文件夹中。
                                            </TextBlock>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>

                            <!-- 未选择规则时的占位 -->
                            <Border Background="{StaticResource PanelAltBrush}"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}, ConverterParameter=invert}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="未选择规则" FontSize="16" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="在左侧选择一条规则，或点击「＋ 新增规则」"
                                               Style="{StaticResource FaintText}"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 问题面板 -->
                        <Border Grid.Row="2"
                                Background="#161210"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding ShowIssues, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="14,8,10,6">
                                    <TextBlock Text="校验问题" Style="{StaticResource SectionTitle}" Margin="0" />
                                    <Button Content="✕" Style="{StaticResource ChipCloseButton}" Click="OnCloseIssues" HorizontalAlignment="Right" />
                                </Grid>
                                <ListBox Grid.Row="1" Height="150" ItemsSource="{Binding Issues}" MouseDoubleClick="OnIssueDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SeverityText}" Foreground="{Binding SeverityColor}" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding LineNumber, StringFormat='第 {0} 行'}" Style="{StaticResource FaintText}" VerticalAlignment="Top" Margin="8,1,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

                <!-- 右：文本预览 -->
                <Border Grid.Column="4" Background="{StaticResource PanelBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="过滤器文本预览" Style="{StaticResource SectionTitle}" Margin="0" />
                                    <TextBlock Text="灰色为注释，选中规则会高亮" Style="{StaticResource FaintText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="复制全部" Command="{Binding CopyPreviewCommand}" Style="{StaticResource BaseButton}" Padding="10,5" MinHeight="28" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1"
                                 x:Name="PreviewList"
                                 ItemsSource="{Binding PreviewBlocks}"
                                 SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                                 Background="#0D0B0A"
                                 Padding="8,8,4,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="8,0" CornerRadius="3" Background="Transparent">
                                        <TextBlock x:Name="Line"
                                                   Text="{Binding Text}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   Foreground="#C7BFAF"
                                                   TextWrapping="NoWrap" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsComment}" Value="True">
                                            <Setter TargetName="Line" Property="Foreground" Value="#6B6156" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#3A3020" />
                                            <Setter TargetName="Line" Property="Foreground" Value="#F1E9D8" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 状态栏 ==================== -->
            <Border Grid.Row="2" Background="#12100E" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilePathText}" Style="{StaticResource FaintText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="  ·  " Style="{StaticResource FaintText}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FaintText}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="OnShowIssues"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,0"
                            MinHeight="20"
                            FontSize="11"
                            Foreground="{Binding IssueCountColor}"
                            Content="{Binding IssueCountText}"
                            Cursor="Hand"
                            ToolTip="查看校验问题" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource FaintText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
