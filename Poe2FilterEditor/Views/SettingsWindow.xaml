<Window x:Class="Poe2FilterEditor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border Background="{StaticResource WindowBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource GoldLightBrush}" />
                    <TextBlock Text="物品映射、音效与保存行为" Style="{StaticResource FaintText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="显示" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Content="界面显示国服中文名（文件仍写入英文内部名）" IsChecked="{Binding ShowChineseNames}" />
                            <TextBlock Text="关闭后界面会显示过滤器里的英文原名，便于和 poe2db 对照。"
                                       Style="{StaticResource FaintText}"
                                       Margin="24,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="保存行为" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Content="保存时把 == / &gt;= 等非标准比较符归一化为隐式写法" IsChecked="{Binding NormalizeOperators}" />
                            <TextBlock Text="样例过滤器里存在 BaseType == &quot;Divine Orb&quot; 这类写法，客户端虽然接受，但标准写法更稳妥。"
                                       Style="{StaticResource FaintText}"
                                       Margin="24,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="音效" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="音效根目录（可留空，默认按过滤器所在目录解析）" Style="{StaticResource FaintText}" Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SoundRootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseSoundRoot" Style="{StaticResource BaseButton}" Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="物品映射表" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding MappingSummary}" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="导入映射 JSON" Click="OnImportMapping" Style="{StaticResource BaseButton}" Padding="12,6" MinHeight="30" Margin="0,0,6,6" />
                                <Button Content="打开映射目录" Click="OnOpenMappingFolder" Style="{StaticResource BaseButton}" Padding="12,6" MinHeight="30" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Text="{Binding MappingStatus}" Style="{StaticResource FaintText}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Click="OnClose" Style="{StaticResource PrimaryButton}" Padding="22,7" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
