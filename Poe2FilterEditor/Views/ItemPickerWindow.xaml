<Window x:Class="Poe2FilterEditor.Views.ItemPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Poe2FilterEditor.Infrastructure"
        Title="{Binding Title}"
        Width="880"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:NullToVisibilityConverter x:Key="InverseNullToVis" />
    </Window.Resources>

    <Border Background="{StaticResource WindowBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource GoldLightBrush}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource FaintText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="186"
                        Margin="0,0,12,0"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="{Binding ShowClassFilter, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="按类别筛选" Style="{StaticResource SectionTitle}" Margin="12,10,12,6" />
                        <ListBox ItemsSource="{Binding ClassFilters}"
                                 SelectedItem="{Binding SelectedClassFilter, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="420">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Padding="10,7" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                            <TextBlock Text="输入中文名或英文名筛选…"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="12"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource InverseNullToVis}, ConverterParameter=invert}" />
                        </Grid>
                        <Button Grid.Column="1" Content="全选" Command="{Binding ToggleAllCommand}" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Padding="10,5" MinHeight="30" />
                        <Button Grid.Column="2" Content="清空" Command="{Binding ClearSelectionCommand}" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Padding="10,5" MinHeight="30" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ListBox ItemsSource="{Binding Rows}"
                                 x:Name="RowsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4"
                                 MouseDoubleClick="OnRowDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Display}" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource FaintText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#3A2C55"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding IsUnique, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="传奇" FontSize="9" Foreground="#C9B6F0" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="未收录"
                                                           Foreground="{StaticResource WarnLightBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部 -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="映射表里没有的名字可以补录（保存在本机，不修改程序自带的映射）"
                                   Style="{StaticResource FaintText}"
                                   Visibility="{Binding ShowCustomEntry, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="{Binding ShowCustomEntry, Converter={StaticResource BoolToVis}}">
                            <TextBox Width="180" Text="{Binding NewNameEn, UpdateSourceTrigger=PropertyChanged}" ToolTip="英文内部名，例如 Divine Orb" />
                            <TextBox Width="150" Text="{Binding NewNameCn, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" ToolTip="国服中文名，例如 神圣石" />
                            <ComboBox Width="150"
                                      ItemsSource="{Binding NewClasses}"
                                      SelectedItem="{Binding NewClass}"
                                      DisplayMemberPath="Display"
                                      Margin="6,0,0,0"
                                      ToolTip="所属类别" />
                            <Button Content="补录" Command="{Binding AddCustomCommand}" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Padding="12,5" MinHeight="30" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FaintText}" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="取消" Click="OnCancel" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Padding="18,7" />
                        <Button Content="添加" Click="OnConfirm" Style="{StaticResource PrimaryButton}" Padding="22,7" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
